{
  "name": "icon-library",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/src/index.js",
    "dev:client": "cd client && npm run dev",
    "build": "npm run build:client",
    "build:client": "npm run build --prefix client",
    "build:server": "node scripts/build-release.js --server-only",
    "build:release": "node scripts/build-release.js",
    "start": "node server/src/index.js"
  },
  "pkg": {
    "scripts": [
      "server/src/**/*.js"
    ],
    "assets": []
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "archiver": "^7.0.1",
    "axios": "^1.16.1",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "element-plus": "^2.14.0",
    "express": "^4.21.0",
    "fs-extra": "^11.2.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^10.0.0",
    "vite": "^8.0.13",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.3.0"
  }
}
